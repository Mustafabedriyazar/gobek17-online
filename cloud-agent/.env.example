# ============================================================================
# G17 Cloud Agent v2 — ortam degiskenleri
# BU DOSYAYA GERCEK SIR YAZILMAZ. Degerler Railway "Variables" ekranindan girilir.
# ============================================================================

# --- API erisimi -----------------------------------------------------------
# Zorunlu. Bos birakilirsa servis calisir ama /health disindaki HER istek 401 doner
# (yani token'siz gorev alinamaz).
# Uretmek icin:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
G17_API_TOKEN=

# --- GitHub ----------------------------------------------------------------
G17_REPO=Mustafabedriyazar/gobek17-online
G17_BRANCH=main

# auto | app | token
GITHUB_AUTH_MODE=auto

# (a) Klasik token yolu — repo contents:write yeterlidir
GITHUB_TOKEN=

# (b) TERCIH EDILEN: GitHub App (kisa omurlu installation token)
#     Izinler: Contents RW, Metadata R, Actions R, Checks R, PR RW, Issues RW
#     Admin / repo delete / org admin / secrets ISTENMEZ.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# --- AI --------------------------------------------------------------------
# auto: gorev metnine gore fable/opus secilir. Istek "provider" alani ezer.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
MAX_AGENT_REPAIR_ATTEMPTS=3

# --- Production dogrulama --------------------------------------------------
G17_PROD_BASE=https://gobekliokey-production.up.railway.app
G17_HEALTH_PATH=/health/live
RAILWAY_WAIT_SECONDS=600
HEALTH_POLL_SECONDS=8

# --- Guard -----------------------------------------------------------------
STRICT_SEQUENTIAL_BUILDS=true
ENGINE_GUARD=strict
TEST_TIMEOUT_SECONDS=300
MAX_NEW_FILE_MB=50

# --- Kalici durum ----------------------------------------------------------
# Railway'de bu yola bir Volume baglanmalidir; yoksa restart'ta gorevler kaybolur.
G17_STATE_DIR=/data/g17
