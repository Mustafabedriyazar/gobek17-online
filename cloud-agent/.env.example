# ============================================================================
# G17 Cloud Agent v2 — ortam degiskenleri
# BU DOSYAYA GERCEK SIR YAZILMAZ. Degerler Railway "Variables" ekranindan girilir.
# ============================================================================

# --- API erisimi -----------------------------------------------------------
# Zorunlu. Bos birakilirsa servis calisir ama /health disindaki HER istek 401 doner
# (yani token'siz gorev alinamaz).
# Uretmek icin:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
G17_API_TOKEN=

# --- GitHub ----------------------------------------------------------------
G17_REPO=Mustafabedriyazar/gobek17-online
G17_BRANCH=main

# auto | app | token
GITHUB_AUTH_MODE=auto

# (a) Klasik token yolu — repo contents:write yeterlidir
GITHUB_TOKEN=

# (b) TERCIH EDILEN: GitHub App (kisa omurlu installation token)
#     Izinler: Contents RW, Metadata R, Actions R, Checks R, PR RW, Issues RW
#     Admin / repo delete / org admin / secrets ISTENMEZ.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# --- AI --------------------------------------------------------------------
AI_PROVIDER=auto
MAX_AGENT_REPAIR_ATTEMPTS=3

# ABONELIK KIMLIGI (VARSAYILAN YOL — API anahtari GEREKMEZ).
# Tarayicisi olan bir makinede BIR KEZ:
#     claude setup-token
# Resmi Claude CLI tarayicida OAuth acar ve BIR YILLIK token basar.
# Komut token'i HICBIR YERE KAYDETMEZ; ciktiyi buraya (Railway Variables)
# yapistirin. Pro / Max / Team / Enterprise aboneligi gerekir.
CLAUDE_CODE_OAUTH_TOKEN=

# ISTEGE BAGLI: API faturalandirmasi kullanmak isterseniz. Doluysa API yolu
# tercih edilir; bos birakilabilir.
ANTHROPIC_API_KEY=

# auto | subscription | api  — ikisi de tanimliysa hangisi kazansin.
# Anthropic dokumani: API anahtari abonelige gore ONCELIKLIDIR. Aboneligi
# kullanmak istiyorsan ya ANTHROPIC_API_KEY'i bos birak ya da burayi
# "subscription" yap.
AI_AUTH_PREFERENCE=auto

# Claude CLI yapilandirma dizini — kalici volume altinda olmali.
# UYARI: CLAUDE_CONFIG_DIR Anthropic tarafindan BELGELENMEMISTIR; tek basina
# guvenilmez. Bu yuzden asagidaki kalici HOME da kullanilir (~/.claude
# belgelenmis konumdur) — ikisi birlikte oturumu restart'lara karsi korur.
CLAUDE_CONFIG_DIR=/data/g17/claude
G17_CLAUDE_HOME=/data/g17/claude-home

# --- Production dogrulama --------------------------------------------------
G17_PROD_BASE=https://gobekliokey-production.up.railway.app
G17_HEALTH_PATH=/health/live
RAILWAY_WAIT_SECONDS=600
HEALTH_POLL_SECONDS=8

# --- Guard -----------------------------------------------------------------
STRICT_SEQUENTIAL_BUILDS=true
ENGINE_GUARD=strict
TEST_TIMEOUT_SECONDS=300
MAX_NEW_FILE_MB=50

# --- Kalici durum ----------------------------------------------------------
# Railway'de bu yola bir Volume baglanmalidir; yoksa restart'ta gorevler kaybolur.
G17_STATE_DIR=/data/g17
